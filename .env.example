# ── Supabase (Project settings → API) ──
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...          # server only, never exposed to the browser

# ── Site ──
NEXT_PUBLIC_SITE_URL=https://motodvorak.netlify.app
# NEXT_PUBLIC_BASE_PATH=/previous-web     # only for the GitHub Pages export

# ── Payments (all optional; a provider without keys stays in test/disabled state) ──
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...             # endpoint URL: https://<site>/api/webhooks/stripe/  (trailing slash required)
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
GOPAY_GOID=
GOPAY_CLIENT_ID=
GOPAY_CLIENT_SECRET=
GOPAY_SANDBOX=true
COMGATE_MERCHANT=
COMGATE_SECRET=
COMGATE_TEST=true
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_SANDBOX=true

# ── Delivery (all optional). Each carrier connects by the best route available:
#    its own API (variables below) → Balíkobot (one login for 30+ carriers) → Zásilkovna's external carriers → manual entry.
BALIKOBOT_API_USER=                     # Balíkobot: API user + key give every catalogue carrier a label route
BALIKOBOT_API_KEY=
# BALIKOBOT_SERVICE_CP=DR               # optional per-shipper service code overrides (see Balíkobot docs)
PACKETA_API_PASSWORD=                   # Zásilkovna e-shop API password
NEXT_PUBLIC_PACKETA_API_KEY=            # public widget key for the pickup-point picker
PACKETA_SENDER_LABEL=motodvorak
PPL_CLIENT_ID=                          # PPL myAPI2 (CPL API)
PPL_CLIENT_SECRET=
GLS_USERNAME=                           # MyGLS API
GLS_PASSWORD=
GLS_CLIENT_NUMBER=
CESKA_POSTA_API_TOKEN=                  # Česká pošta B2B nAPI (Balík Do ruky, Na poštu, Balíkovna)
CESKA_POSTA_SECRET_KEY=
CESKA_POSTA_CUSTOMER_ID=
CESKA_POSTA_LOCATION_NUMBER=
DPD_API_KEY=                            # DPD Shipping API (bearer key from DPD support)
DPD_CUSTOMER_ID=
WEDO_API_TOKEN=                         # One by Allegro (WE|DO) REST API v2
WEDO_SANDBOX=false

# ── Email notifications (Resend) ──
RESEND_API_KEY=
