# ── Supabase (Project settings → API) ──
NEXT_PUBLIC_SUPABASE_URL=https://xxxx.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=eyJ...
SUPABASE_SERVICE_ROLE_KEY=eyJ...          # server only, never exposed to the browser

# ── Site ──
NEXT_PUBLIC_SITE_URL=https://motodvorak.netlify.app
# NEXT_PUBLIC_BASE_PATH=/previous-web     # only for the GitHub Pages export

# ── Payments (all optional; a provider without keys stays in test/disabled state) ──
STRIPE_SECRET_KEY=sk_test_...
STRIPE_WEBHOOK_SECRET=whsec_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_test_...
GOPAY_GOID=
GOPAY_CLIENT_ID=
GOPAY_CLIENT_SECRET=
GOPAY_SANDBOX=true
COMGATE_MERCHANT=
COMGATE_SECRET=
COMGATE_TEST=true
PAYPAL_CLIENT_ID=
PAYPAL_CLIENT_SECRET=
PAYPAL_SANDBOX=true

# ── Delivery (all optional) ──
PACKETA_API_PASSWORD=
NEXT_PUBLIC_PACKETA_API_KEY=            # public widget key for the pickup-point picker
PACKETA_SENDER_LABEL=motodvorak
PPL_CLIENT_ID=
PPL_CLIENT_SECRET=
DPD_CLIENT_KEY=
DPD_EMAIL=
CESKA_POSTA_API_TOKEN=
CESKA_POSTA_SECRET_KEY=
GLS_USERNAME=
GLS_PASSWORD=
FOFR_API_KEY=

# ── Email notifications (Resend) ──
RESEND_API_KEY=
